@model IKimWebConsole.Domain.Order

<div class="modal fade" id="modal-order" tabindex="-1" aria-labelledby="OrderModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="OrderModalLabel">Edit Order</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="OrderModalLabel">Add Order</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)

                <div class="row mb-2">

                    <div class="col">
                        <label>Date <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Date, new { @class = "form-control", type = "date", @Value = DateTime.Now.ToString("yyyy-MM-dd") })
                        <span class="text-danger"></span>
                    </div>
                    
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Store <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.StoreId, ViewBag.Stores as List<SelectListItem>, "Select Store", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/custom-js/order/create.js")"></script>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)
