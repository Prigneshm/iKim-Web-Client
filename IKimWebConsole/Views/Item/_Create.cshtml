@model IKimWebConsole.Domain.Item

<div class="modal fade" id="modal-item" tabindex="-1" aria-labelledby="ItemModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="ItemModalLabel">Edit Item</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="ItemModalLabel">Add Item</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)
                <div class="row mb-2">
                    <div class="col">
                        <label>Category <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.CategoryId, ViewBag.Categories as List<SelectListItem>, "Select Category", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col">
                        <label>Name <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter Name" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Unit Of Measure <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.UnitOfMeasureId, ViewBag.UnitOfMeasures as List<SelectListItem>, "Select Unit Of Measure", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Description</label>
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", placeholder = "Enter Description", rows = "3" })
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col">
                        <label>HSN Code <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.HSNCode, new { @class = "form-control", placeholder = "Enter HSN Code" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col-6">
                        <label>GST <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.GST, new { @class = "form-control", placeholder = "Enter GST" , @readonly = "readOnly"})
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col">
                        <label>CGST <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.CGST, new { @class = "form-control", placeholder = "Enter CGST" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>SGST <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.SGST, new { @class = "form-control", placeholder = "Enter SGST" })
                        <span class="text-danger"></span>
                    </div>
                </div>
             
                <div class="row mb-2">
                    <div class="col">
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th hidden>Tier</th>
                                    <th>Tier</th>
                                    <th>Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Prices.Count; i++)
                                {
                                    <tr>
                                        <td hidden>@Html.HiddenFor(m => m.Prices[i].PricingTierId)</td>
                                        <td>@Model.Prices[i].PricingTierName</td>
                                        <td>@Html.TextBoxFor(m => m.Prices[i].Price, new { type = "number", step = "1.00", @class = "form-control" })</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                            <label class="form-check-label" for="isActiveCheck">Is Active?</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/custom-js/item/create.js")"></script>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)