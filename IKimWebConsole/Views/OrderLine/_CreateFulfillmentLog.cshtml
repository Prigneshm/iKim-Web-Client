@model IKimWebConsole.Domain.FulfillmentLog

<div class="modal fade" id="modal-fulfillment-log" tabindex="-1" aria-labelledby="FulfillmentModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="FulfillmentModalLabel">Edit Item Fulfillment</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="FulfillmentModalLabel">Add Item Fulfillment</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.OrderLineId)
                @Html.HiddenFor(m => m.QuantityRequested)

                <div class="row mb-2">
                    <div class="col">
                        <label>Item</label>
                        @Html.DropDownListFor(m => m.ItemId, ViewBag.Items as List<SelectListItem>, "Select Item", new { @class = "form-control", @disabled = "disabled" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Quantity Requested</label>
                        @Html.TextBoxFor(m => m.QuantityRequested, new { @class = "form-control", @disabled = "disabled" })
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col">
                        <label>Quantity Fulfilled <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.QuantityFulfilled, new { @class = "form-control", placeholder = "Enter Name" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Notes</label>
                        @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", placeholder = "Enter Notes", rows = 3 })
                        <span class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/custom-js/fulfillment-log/create.js")"></script>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)